msgstr ""
"Għal din l-azzjoni hija meħtieġa tassonomija appoġġjata u permess biex tiġi"
" amministrata."

#: includes/class-ypm-ai-translation.php:815
msgid "A translation already exists for the target locale."
msgstr "Diġà teżisti traduzzjoni għal-lokalizzazzjoni fil-mira."

#: includes/class-ypm-ai-translation.php:832
