msgid ""
"A Site Translation Plan is already running. Pause or finish it before "
"starting a current-page batch."
msgstr ""
"Plan prevođenja web-mjesta već se izvršava. Pauzirajte ga ili dovršite "
"prije pokretanja skupne obrade trenutačne stranice."

#: includes/class-ypm-ai-jobs.php:63
